GEMINI_API_KEY=
OPENAI_API_KEY=

# Higgsfield (slow-motion loops via Kling 2.1 Pro image-to-video)
HF_API_KEY=
HF_API_SECRET=
# Optionnel : surcharger le modèle Higgsfield (default: kling-video/v2.1/pro/image-to-video)
# Alternatives: higgsfield-ai/dop/standard, higgsfield-ai/dop/preview, bytedance/seedance/v1/pro/image-to-video
# HIGGSFIELD_SLOWMO_MODEL=kling-video/v2.1/pro/image-to-video
# HIGGSFIELD_SLOWMO_DURATION=5
# HIGGSFIELD_SLOWMO_PRICE_USD=0.35
# Mode dry-run (skip appel API, utile en dev) :
# SLOWMO_DRY_RUN=1

# ━━ SSO Google OAuth (Martin 19/05/2026) ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# Récupérés via Google Cloud Console > APIs & Services > Credentials
# Setup : voir DEPLOY_RAILWAY.md
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Clé pour signer les cookies session Flask (32+ bytes hex)
# Générer avec : python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# Domaine email autorisé (default: dayuse.com)
ALLOWED_EMAIL_DOMAIN=dayuse.com
# Désactive complètement le SSO (debug uniquement, NE PAS UTILISER EN PROD)
# AUTH_DISABLED=1

# ━━ DB (Postgres en prod Railway, SQLite en local) ━━━━━━━━━━━━━━━━━━━━━━━
# En prod Railway, l'addon Postgres injecte automatiquement DATABASE_URL.
# En local, laisser vide → fallback SQLite (data/audit.db)
# DATABASE_URL=postgresql://user:password@host:port/db

