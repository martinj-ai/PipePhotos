GEMINI_API_KEY=

# Higgsfield (slow-motion loops via Kling 2.1 Pro image-to-video)
HF_API_KEY=
HF_API_SECRET=
# Optionnel : surcharger le modèle Higgsfield (default: kling-video/v2.1/pro/image-to-video)
# Alternatives: higgsfield-ai/dop/standard, higgsfield-ai/dop/preview, bytedance/seedance/v1/pro/image-to-video
# HIGGSFIELD_SLOWMO_MODEL=kling-video/v2.1/pro/image-to-video
# HIGGSFIELD_SLOWMO_DURATION=5
# HIGGSFIELD_SLOWMO_PRICE_USD=0.35
# Mode dry-run (skip appel API, utile en dev) :
# SLOWMO_DRY_RUN=1

